            "timeout": 5
          }
        ],
        "matcher": "Bash"
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "f=\"${HOME:-$USERPROFILE}/.claude/golden-thread/wired/PreToolUse__guard_install.sh\"; if [ -f \"$f\" ]; then . \"$f\"; fi",
            "timeout": 75,
            "onFailure": "block"
          }
        ],
        "matcher": "Bash|PowerShell"
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "f=\"${HOME:-$USERPROFILE}/.claude/golden-thread/wired/PreToolUse__gt_integrity.py\"; if [ -f \"$f\" ]; then . \"$f\"; fi",
            "timeout": 5
          }
        ],
        "matcher": "Bash"
      },
      {
        "hooks": [
