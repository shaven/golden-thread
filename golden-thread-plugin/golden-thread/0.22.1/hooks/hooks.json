            "onFailure": "block"
          }
        ],
        "matcher": "Bash"
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "f=\"${HOME:-$USERPROFILE}/.claude/golden-thread/wired/PreToolUse__guard_scope_contract.sh\"; if [ -f \"$f\" ]; then . \"$f\"; fi",
