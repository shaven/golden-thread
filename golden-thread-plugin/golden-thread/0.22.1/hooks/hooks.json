          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "f=\"${HOME:-$USERPROFILE}/.claude/golden-thread/wired/UserPromptSubmit__gt_expiry_guard.py\"; if [ -f \"$f\" ]; then . \"$f\"; fi",
            "timeout": 5
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "f=\"${HOME:-$USERPROFILE}/.claude/golden-thread/wired/UserPromptSubmit__gt_hints.py\"; if [ -f \"$f\" ]; then . \"$f\"; fi",
            "timeout": 3
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "f=\"${HOME:-$USERPROFILE}/.claude/golden-thread/wired/UserPromptSubmit__gt_intake.py\"; if [ -f \"$f\" ]; then . \"$f\"; fi",
