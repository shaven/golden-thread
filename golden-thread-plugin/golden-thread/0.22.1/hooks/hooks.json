        "hooks": [
          {
            "type": "command",
            "command": "f=\"${HOME:-$USERPROFILE}/.claude/golden-thread/wired/UserPromptSubmit__inject_core_rules.sh\"; if [ -f \"$f\" ]; then . \"$f\"; fi",
            "timeout": 10
          }
        ]
      }
