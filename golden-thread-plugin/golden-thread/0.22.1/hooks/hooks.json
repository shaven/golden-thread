    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "f=\"${HOME:-$USERPROFILE}/.claude/golden-thread/wired/PreCompact__gt_state.py\"; if [ -f \"$f\" ]; then . \"$f\"; fi"
