            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "f=\"${HOME:-$USERPROFILE}/.claude/golden-thread/wired/Stop__gt_hints.py\"; if [ -f \"$f\" ]; then . \"$f\"; fi",
