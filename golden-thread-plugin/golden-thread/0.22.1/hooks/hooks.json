{
  "description": "Golden Thread (gt): each entry runs the command gt's installer wired for this machine, when it wired one",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -f \"${HOME:-$USERPROFILE}/.claude/golden-thread/hooks/gt_paths.py\" ] || { s=\"${CLAUDE_PLUGIN_ROOT}/scripts/gt_setup.py\"; { command -v py >/dev/null 2>&1 && py -3 -I \"$s\" hook; } || python3 -I \"$s\" hook 2>/dev/null || python -I \"$s\" hook; }",
            "timeout": 5
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "f=\"${HOME:-$USERPROFILE}/.claude/golden-thread/wired/SessionStart__gt_components.py\"; if [ -f \"$f\" ]; then . \"$f\"; fi"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "f=\"${HOME:-$USERPROFILE}/.claude/golden-thread/wired/SessionStart__gt_workers.py\"; if [ -f \"$f\" ]; then . \"$f\"; fi"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "f=\"${HOME:-$USERPROFILE}/.claude/golden-thread/wired/SessionStart__gt_version_check.py\"; if [ -f \"$f\" ]; then . \"$f\"; fi"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "f=\"${HOME:-$USERPROFILE}/.claude/golden-thread/wired/SessionStart__gt_push_check.py\"; if [ -f \"$f\" ]; then . \"$f\"; fi"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "f=\"${HOME:-$USERPROFILE}/.claude/golden-thread/wired/SessionStart__gt_surface.py\"; if [ -f \"$f\" ]; then . \"$f\"; fi"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "f=\"${HOME:-$USERPROFILE}/.claude/golden-thread/wired/SessionStart__gt_unlock.py\"; if [ -f \"$f\" ]; then . \"$f\"; fi"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "f=\"${HOME:-$USERPROFILE}/.claude/golden-thread/wired/SessionStart__gt_grant.py\"; if [ -f \"$f\" ]; then . \"$f\"; fi"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "f=\"${HOME:-$USERPROFILE}/.claude/golden-thread/wired/SessionStart__gt_queue_autodrain.py\"; if [ -f \"$f\" ]; then . \"$f\"; fi",
            "timeout": 30
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "f=\"${HOME:-$USERPROFILE}/.claude/golden-thread/wired/SessionStart__gt_calibration_schedule.py\"; if [ -f \"$f\" ]; then . \"$f\"; fi",
            "timeout": 5
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "f=\"${HOME:-$USERPROFILE}/.claude/golden-thread/wired/SessionStart__gt_skill_runlog.py\"; if [ -f \"$f\" ]; then . \"$f\"; fi",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "f=\"${HOME:-$USERPROFILE}/.claude/golden-thread/wired/SessionStart__gt_session_search.py\"; if [ -f \"$f\" ]; then . \"$f\"; fi",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "f=\"${HOME:-$USERPROFILE}/.claude/golden-thread/wired/SessionStart__gt_addon_scan.py\"; if [ -f \"$f\" ]; then . \"$f\"; fi",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "f=\"${HOME:-$USERPROFILE}/.claude/golden-thread/wired/SessionStart__gt_mcp_pin.py\"; if [ -f \"$f\" ]; then . \"$f\"; fi",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "f=\"${HOME:-$USERPROFILE}/.claude/golden-thread/wired/SessionStart__inject_core_rules.sh\"; if [ -f \"$f\" ]; then . \"$f\"; fi",
            "timeout": 10
          }
        ],
        "matcher": "compact"
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "f=\"${HOME:-$USERPROFILE}/.claude/golden-thread/wired/UserPromptSubmit__gt_state.py\"; if [ -f \"$f\" ]; then . \"$f\"; fi"
