        ],
        "matcher": "Bash"
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "f=\"${HOME:-$USERPROFILE}/.claude/golden-thread/wired/PreToolUse__guard_lotr_agent.py\"; if [ -f \"$f\" ]; then . \"$f\"; fi",
