{
  "schema": 1,
  "slot": "secrets",
  "name": "common",
  "tier": "A",
  "spdx": "MIT",
  "provenance": {
    "origin": "original",
    "contributor": "Golden Thread <gt@example.com>",
    "upstream": null
  },
  "dco": "Signed-off-by: Golden Thread <gt@example.com>",
  "notes": "Vendor-prefixed shapes only: the credentials easiest to rotate. The generic assignment+entropy rule in gt_secrets.py is what finds a .env full of passwords. Written from published public prefixes, NOT copied from any rule corpus -- Semgrep's rules forbid redistribution. See the vault design doc.",
  "entries": [
    {
      "id": "aws.access-key-id",
      "pattern": "\\b(?:AKIA|ASIA|ABIA|ACCA)[0-9A-Z]{16}\\b"
    },
    {
      "id": "github.token",
      "pattern": "\\bgh[pousr]_[A-Za-z0-9]{36,255}\\b"
    },
    {
      "id": "gitlab.token",
      "pattern": "\\bglpat-[A-Za-z0-9_\\-]{20,}\\b"
    },
    {
      "id": "slack.token",
      "pattern": "\\bxox[abprse]-[0-9A-Za-z\\-]{10,}\\b"
    },
    {
      "id": "stripe.secret-key",
      "pattern": "\\b[sr]k_(?:live|test)_[0-9A-Za-z]{16,}\\b"
    },
    {
      "id": "google.api-key",
      "pattern": "\\bAIza[0-9A-Za-z_\\-]{35}\\b"
    },
    {
      "id": "anthropic.api-key",
      "pattern": "\\bsk-ant-[A-Za-z0-9_\\-]{20,}"
    },
    {
      "id": "openai.project-key",
      "pattern": "\\bsk-(?:proj|svcacct|admin)-[A-Za-z0-9_\\-]{20,}"
    },
    {
      "id": "github.fine-grained-token",
      "pattern": "\\bgithub_pat_[A-Za-z0-9_]{22,}"
    },
    {
      "id": "openai.api-key",
      "pattern": "\\bsk-[A-Za-z0-9]{20,}\\b"
    },
    {
      "id": "npm.token",
      "pattern": "\\bnpm_[A-Za-z0-9]{36}\\b"
    },
    {
      "id": "twilio.account-sid",
      "pattern": "\\bAC[0-9a-fA-F]{32}\\b"
    },
    {
      "id": "sendgrid.api-key",
      "pattern": "\\bSG\\.[A-Za-z0-9_\\-]{22}\\.[A-Za-z0-9_\\-]{43}\\b"
    },
    {
      "id": "private-key.block",
      "pattern": "-----BEGIN (?:RSA |EC |DSA |OPENSSH |PGP )?PRIVATE KEY(?: BLOCK)?-----"
    },
    {
      "id": "jwt.compact",
      "pattern": "\\beyJ[A-Za-z0-9_\\-]{10,200}\\.eyJ[A-Za-z0-9_\\-]{10,4096}\\.[A-Za-z0-9_\\-]{10,1024}\\b"
    },
    {
      "id": "basic-auth.in-url",
      "pattern": "[a-z][a-z0-9+.\\-]{0,31}://[^/\\s:@]{1,256}:[^/\\s:@]{1,512}@"
    }
  ]
}
