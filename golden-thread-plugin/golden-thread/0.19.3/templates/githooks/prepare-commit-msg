#!/bin/sh
# Append Session-Edit: trailers naming WHICH SESSION on WHICH MACHINE changed each
# staged file. Source: .git/gt-edits.jsonl, written by safe_write() via
# Projects/golden-thread/tools/gt_edits.py.
#
# The commit message IS the permanent store. Git history is immutable and already
# replicated by every clone, so nothing has to be reconciled into a second tracked
# ledger -- which matters, because a shared tracked ledger would be precisely the
# kind of file the concurrent-session problem destroys.
#
# FAILS OPEN, always. A commit must never be blocked by bookkeeping: every path
# here exits 0 and leaves the message untouched on any failure. Same rule the Stop
# validator and the claim guard follow -- a hook that blocks wrongly makes the repo
# unusable, which is a worse failure than the gap it closes.
#
# Skips merge/squash/amend ($2 set): those messages are generated or reused, and
# appending to them duplicates trailers.
#
# All message editing happens in Python. The shell version needed a flag to survive
# a `while read` loop, which runs in a subshell after a pipe, so the flag reset on
# every iteration and the blank line was never written.

# `set -u` turns a misspelt variable into an error instead of an empty string. It has to
# come WITH the `:-` defaults below, not before them: git calls this hook with one, two or
# three arguments, so $2 is routinely unset, and a bare `set -u` would abort the hook --
# which for prepare-commit-msg aborts the COMMIT. That is the exact failure the fail-open
# rule above exists to prevent, so the lint fix and the defaults are one change.
set -u

# Native Windows (0.19.3): in Git Bash `python3` is the Microsoft Store stub, so every commit to
# a gt vault failed ("Python was not found"). Use the interpreter gt's installer recorded, else
# the first python3/python on PATH that is not under ...\WindowsApps\. Elsewhere a no-op; written
# so a POSIX sh (dash) still parses it.
case "${OSTYPE:-}" in
  msys*|cygwin*)
    _gt_py=""
    if [ -r "$HOME/.claude/golden-thread/python" ]; then
      IFS= read -r _gt_py < "$HOME/.claude/golden-thread/python" || true
      _gt_py=$(printf '%s' "$_gt_py" | tr -d '\r')
    fi
    if [ -z "$_gt_py" ]; then
      _gt_ifs=$IFS; IFS='
'
      for _gt_c in $(type -aP python3 python 2>/dev/null); do
        case "$_gt_c" in */[Ww]indows[Aa]pps/*) continue ;; esac
        _gt_py=$_gt_c; break
      done
      IFS=$_gt_ifs
    fi
    if [ -n "$_gt_py" ]; then
      export PYTHONUTF8=1
      eval 'python3() { "$_gt_py" "$@" | tr -d "\r"; return "${PIPESTATUS[0]}"; }'
    fi ;;
esac

MSG_FILE="${1:-}"
MSG_SOURCE="${2:-}"

[ -n "$MSG_FILE" ] && [ -f "$MSG_FILE" ] || exit 0

case "$MSG_SOURCE" in
  merge|squash|commit) exit 0 ;;
esac

GIT_DIR_ABS=$(git rev-parse --absolute-git-dir 2>/dev/null) || exit 0
ROOT=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0
TOOL="$ROOT/Projects/golden-thread/tools/gt_edits.py"

[ -f "$TOOL" ] || exit 0
[ -f "$GIT_DIR_ABS/gt-edits.jsonl" ] || exit 0

(cd "$ROOT" && python3 "$TOOL" apply-msg "$MSG_FILE" >/dev/null 2>&1)
exit 0
