#!/bin/sh
# Drain the edit ledger AFTER a commit succeeds.
#
# Deliberately post-commit rather than prepare-commit-msg: if the ledger were
# truncated while composing the message and the commit were then aborted (empty
# message, hook rejection, Ctrl-C), the attribution for those edits would be gone
# with no way to recover it. Clearing only once the commit exists means an aborted
# commit costs nothing.
#
# Entries for files still modified in the working tree are RETAINED, so an edit
# that was not part of this commit stays attributed for whenever it is committed.
#
# FAILS OPEN: nothing here can affect the commit, which has already happened.

# `set -u` so a misspelt variable is an error rather than an empty string. Safe here
# because this hook reads no positional arguments -- unlike prepare-commit-msg, where
# git leaves $2 unset and an unguarded `set -u` would abort the commit.
set -u

# Native Windows (0.19.3): in Git Bash `python3` is the Microsoft Store stub, so every commit to
# a gt vault failed ("Python was not found"). Use the interpreter gt's installer recorded, else
# the first python3/python on PATH that is not under ...\WindowsApps\. Elsewhere a no-op; written
# so a POSIX sh (dash) still parses it.
case "${OSTYPE:-}" in
  msys*|cygwin*)
    _gt_py=""
    if [ -r "$HOME/.claude/golden-thread/python" ]; then
      IFS= read -r _gt_py < "$HOME/.claude/golden-thread/python" || true
      _gt_py=$(printf '%s' "$_gt_py" | tr -d '\r')
    fi
    if [ -z "$_gt_py" ]; then
      _gt_ifs=$IFS; IFS='
'
      for _gt_c in $(type -aP python3 python 2>/dev/null); do
        case "$_gt_c" in */[Ww]indows[Aa]pps/*) continue ;; esac
        _gt_py=$_gt_c; break
      done
      IFS=$_gt_ifs
    fi
    if [ -n "$_gt_py" ]; then
      export PYTHONUTF8=1
      eval 'python3() { "$_gt_py" "$@" | tr -d "\r"; return "${PIPESTATUS[0]}"; }'
    fi ;;
esac

GIT_DIR_ABS=$(git rev-parse --absolute-git-dir 2>/dev/null) || exit 0
ROOT=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0
TOOL="$ROOT/Projects/golden-thread/tools/gt_edits.py"

[ -f "$TOOL" ] || exit 0
[ -f "$GIT_DIR_ABS/gt-edits.jsonl" ] || exit 0

(cd "$ROOT" && python3 "$TOOL" commit-clear >/dev/null 2>&1)
exit 0
