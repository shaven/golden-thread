#!/bin/sh
# Refuse a commit that would add a credential.
#
# FAILS CLOSED, and it is the only hook here that does. The other two --
# prepare-commit-msg and post-commit -- are BOOKKEEPING: they attribute edits, and a
# commit must never be blocked by bookkeeping, so every path in them exits 0. This one
# is a SECURITY GATE, and the asymmetry is the whole reason it is a separate file:
#
#   a missed attribution can be reconstructed later; a credential in git history cannot
#   be un-published. It is in every clone, every fork and every backup, immediately and
#   permanently, and the only real remedy is rotating the credential.
#
# So "I could not check" is treated as "do not commit", never as "probably fine". That is
# the same rule tests/run.sh applies to the same scanner: an absent scanner is reported as
# NOT RUN, and NOT RUN is not clean.
#
# THE INDEX, NOT THE WORKING TREE. gt_secrets.py --staged reads staged blobs, because
# those are what the commit will contain. `git add` a credential and then tidy the file in
# your editor and the worktree is clean while the commit is not; a gate reading the
# worktree would wave that through. Tested both directions in test_gt_secrets.TheCommitGate.
#
# TWO WAYS PAST IT, both deliberate and both loud:
#   git commit --no-verify              skip every hook, once. Git's own escape.
#   git config gt.secretsgate off       disable this gate for this clone. Never silent:
#                                       the hook prints that it is off on every commit,
#                                       because a gate you have forgotten you disabled is
#                                       indistinguishable from one that is working.
#
# A finding you have examined and accepted belongs in a BASELINE, not in either of those:
#   python3 <gt>/scripts/gt_secrets.py . --write-baseline .gt/secrets-baseline.json
# The hook picks that file up automatically if it exists, so accepted findings go quiet
# while anything NEW still blocks.

# `set -u` because this hook FAILS CLOSED: a misspelt variable here must be an error, not a
# silently empty path that skips a check. Its two neighbours deliberately do NOT set it -- for
# them an abort would block a commit over bookkeeping, which is the opposite of what they are
# for. gt-scan-code's sh-missing-nounset rule flags all three; theirs is a baselined exception
# with the reason recorded, this one is a real fix. Every expansion below is :-guarded.
set -u

# Native Windows (0.20.0): in Git Bash `python3` is the Microsoft Store stub, so every commit to
# a gt vault failed ("Python was not found"). Use the interpreter gt's installer recorded, else
# the first python3/python on PATH that is not under ...\WindowsApps\. Elsewhere a no-op; written
# so a POSIX sh (dash) still parses it.
case "${OSTYPE:-}" in
  msys*|cygwin*)
    _gt_py=""
    if [ -r "$HOME/.claude/golden-thread/python" ]; then
      IFS= read -r _gt_py < "$HOME/.claude/golden-thread/python" || true
      _gt_py=$(printf '%s' "$_gt_py" | tr -d '\r')
    fi
    if [ -z "$_gt_py" ]; then
      _gt_ifs=$IFS; IFS='
'
      for _gt_c in $(type -aP python3 python 2>/dev/null); do
        case "$_gt_c" in */[Ww]indows[Aa]pps/*) continue ;; esac
        _gt_py=$_gt_c; break
      done
      IFS=$_gt_ifs
    fi
    if [ -n "$_gt_py" ]; then
      export PYTHONUTF8=1
      eval 'python3() { "$_gt_py" "$@" | tr -d "\r"; return "${PIPESTATUS[0]}"; }'
    fi ;;
esac

STATE=$(git config --get gt.secretsgate 2>/dev/null)
if [ "$STATE" = "off" ]; then
  echo "gt-secrets: gate is OFF for this clone (git config gt.secretsgate off) — not scanned" >&2
  exit 0
fi

ROOT=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0

# The newest installed release, resolved by glob order rather than by a pinned path, so the
# hook keeps working across upgrades without being rewritten.
#
# GT_SECRETS_BIN overrides it, for an install that is not in the default cache -- and for
# gt's own test suite, which must exercise this hook against the release under test rather
# than against whatever happens to be installed on the machine running the tests. It is
# ANNOUNCED whenever it is in effect, by the same rule as the off switch below: a gate
# quietly pointed at a different scanner than you think is a gate you cannot trust.
SEC=""
if [ -n "${GT_SECRETS_BIN:-}" ]; then
  if [ ! -f "$GT_SECRETS_BIN" ]; then
    echo "COMMIT REFUSED — GT_SECRETS_BIN is set to '${GT_SECRETS_BIN}', which does not exist." >&2
    exit 1
  fi
  SEC="$GT_SECRETS_BIN"
  # Native Windows (0.20.0): a C:\...\gt_secrets.py override kept its backslashes, so the
  # ${SEC%/gt_secrets.py} below matched nothing and the code gate and the check report looked
  # for files that cannot exist -- and were skipped without a word. Git Bash reads "/" too.
  case "${OSTYPE:-}" in msys*|cygwin*) SEC=$(printf '%s' "$SEC" | tr '\\' '/') ;; esac
  echo "gt-secrets: using GT_SECRETS_BIN=$SEC (not the installed release)" >&2
else
  for d in "${HOME:-}"/.claude/plugins/cache/golden-thread-plugin/gt/*/scripts/gt_secrets.py; do
    [ -f "$d" ] && SEC="$d"
  done
fi

if [ -z "$SEC" ]; then
  cat >&2 <<'MSG'

COMMIT REFUSED — the credential scanner is not installed, so this commit was NOT checked.

  Looked in: ~/.claude/plugins/cache/golden-thread-plugin/gt/*/scripts/gt_secrets.py

This is not "probably fine". A credential committed here is in every clone and every
backup permanently, and the only remedy is rotating it. "Could not check" is therefore
treated as "do not commit".

  Install golden-thread:   bash <plugin-repo>/install.sh
  Commit once anyway:      git commit --no-verify
  Disable for this clone:  git config gt.secretsgate off

MSG
  exit 1
fi

BASELINE=""
[ -f "$ROOT/.gt/secrets-baseline.json" ] && BASELINE="--baseline $ROOT/.gt/secrets-baseline.json"

# shellcheck disable=SC2086  # BASELINE is a deliberate two-word expansion or empty
OUT=$(python3 "$SEC" "$ROOT" --staged $BASELINE 2>&1)
RC=$?

# File the verdict in the vault, so "is this gate actually running?" is answerable from
# history rather than from memory. Bookkeeping only: it never changes RC, it passes NO
# finding content (gt_check_report has nowhere to put any), and a vault-less machine just
# skips it. The scope is the string "staged diff", never the file list -- naming the files
# would put a credential's location in a file that is committed and pushed.
#
# AND NOT WHEN THE REPO BEING COMMITTED *IS* THE VAULT. Writing a vault file from a vault
# pre-commit hook leaves an unstaged modification behind after every single commit: the report
# is written, the commit does not include it, and the working tree is dirty from then on --
# forever, one line per commit. Found immediately, by 18 test units that assert a vault is
# clean after an install. The record is worth having for a commit in a CODE repo, where the
# vault is a separate place to write to; inside the vault the test-run gate already records,
# and a permanently dirty tree is a worse outcome than a thinner history.
#
# OPT-IN, and off by default:
#     git config gt.checkreport on
#
# Recording is useful, but a hook that writes to the vault on every commit in every repo on
# the machine is a side effect nobody asked for at the moment they typed `git commit`. It
# leaves the vault dirty from unrelated work, and the dirt accumulates one line per commit.
# gt's own demo test caught this by asserting the configured vault is untouched by every
# command -- a commit in the DEMO vault was writing into the real one. The vault-is-the-repo
# case below is a separate guard for a separate reason, and both are needed.
#
# The test-run gate in tests/run.sh records unconditionally, and that is the right default
# for the opposite reason: running the suite is a deliberate act in one known repo.
REPORT_ON=$(git config --get gt.checkreport 2>/dev/null)
REP="${SEC%/gt_secrets.py}/gt_check_report.py"
if [ "$REPORT_ON" = "on" ] && [ -f "$REP" ]; then
  VAULT=$(python3 -c 'import json,os;print(json.load(open(os.path.expanduser("~/.claude/vault-config.json")))["vault_path"])' 2>/dev/null)
  if [ -n "$VAULT" ] && [ "$(cd "$VAULT" 2>/dev/null && pwd -P)" = "$(cd "$ROOT" && pwd -P)" ]; then
    VAULT=""            # committing inside the vault: do not dirty it
  fi
  if [ -n "$VAULT" ]; then
    case "$RC" in
      0) V=clean ;;
      1) V=findings ;;
      *) V=cannot-run ;;
    esac
    python3 "$REP" record --vault "$VAULT" --check secrets-commit --verdict "$V" \
      --scope "staged diff" >/dev/null 2>&1 || true
  fi
fi

# ── The source-validation gate ─────────────────────────────────────────────────
#
# Runs only when the credential gate passed, because a credential is the more urgent finding
# and two walls of output at once is how people learn to reach for --no-verify.
#
# ONE DELIBERATE ASYMMETRY from the gate above: for gt_secrets, "could not run" BLOCKS --
# unknown is not clean when the subject is a credential. Here exit 3 means a RULE WAS SKIPPED
# because this machine lacks an optional evaluator tier, which is the expected state on most
# machines and says nothing about the staged code. Blocking on it would refuse every commit
# everywhere ast_grep_py is not installed, and the first thing anyone would do is delete this
# hook. So a skip is REPORTED and allowed; only a real finding blocks.
if [ "$RC" -eq 0 ]; then
  SCAN="${SEC%/gt_secrets.py}/gt_scan_code.py"
  if [ -f "$SCAN" ]; then
    CBASE=""
    [ -f "$ROOT/.gt/code-baseline.json" ] && CBASE="--baseline $ROOT/.gt/code-baseline.json"
    # shellcheck disable=SC2086  # CBASE is a deliberate two-word expansion or empty
    COUT=$(python3 "$SCAN" "$ROOT" --staged $CBASE 2>&1)
    CRC=$?
    case "$CRC" in
      0) : ;;                                   # clean; the credential gate prints the summary
      1)
        echo "$COUT" >&2
        cat >&2 <<'MSG'

COMMIT REFUSED — source validation found something in the staged code. Each line above is
path:line, the rule that fired, and what it is about.

  Rule is wrong?      fix the rule, or accept the finding WITH A REASON:
                      python3 <gt>/scripts/gt_scan_code.py . --write-baseline .gt/code-baseline.json
                      then add a `reasons` entry saying why — an accepted finding with no
                      recorded reason is a silenced one.
  Commit anyway:      git commit --no-verify

MSG
        exit 1
        ;;
      *)
        # A skipped rule, a pack problem, or no rules at all. Reported, never fatal.
        printf '%s\n' "$COUT" | sed -n '/SKIPPED\|PROBLEM\|CANNOT RUN/p' >&2
        echo "gt-scan-code: PARTIAL (exit $CRC) — some rules did not run here; not blocking" >&2
        ;;
    esac
  fi
fi

case "$RC" in
  0) echo "$OUT" ;;
  1)
    echo "$OUT" >&2
    cat >&2 <<'MSG'

COMMIT REFUSED — a credential-shaped value is staged. Each line above is path:line plus a
rule id and a LENGTH; the value itself is never printed, by design.

  Not a credential?   the rule is wrong and should be FIXED, or the finding recorded:
                      python3 <gt>/scripts/gt_secrets.py . --write-baseline .gt/secrets-baseline.json
  It is one?          do not commit it. Move it to the secrets store, then rotate it --
                      assume anything that reached your disk in plaintext is compromised.
  Commit anyway:      git commit --no-verify

MSG
    exit 1
    ;;
  *)
    echo "$OUT" >&2
    echo "COMMIT REFUSED — the scanner could not complete (exit $RC), so nothing was" >&2
    echo "verified. Fix the error above, or: git commit --no-verify" >&2
    exit 1
    ;;
esac
exit 0
